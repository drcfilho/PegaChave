# Ignorar pastas de binários locais e banco de dados local
bin/*
!bin/*.php
!bin/mysql/
bin/mysql/*
!bin/mysql/schema.sql

# Ignorar banco de dados SQLite local se existir
*.sqlite
*.db

# Arquivos de logs e temporários
*.log
tmp/
cache/*
!cache/.gitkeep
.vscode/
.idea/

# Ignorar arquivos Markdown de controle interno (exceto README e CHANGELOG)
*.md
!README.md
!CHANGELOG.md
!docs/wiki/*.md

# Arquivos de IDE e testes soltos
test*.php
refactor*.php
fix*.php
*.py

# Configurações sensíveis
.env
